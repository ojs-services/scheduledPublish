<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE scheduled_tasks SYSTEM "../../../lib/pkp/dtd/scheduledTasks.dtd">

<!--
  * plugins/generic/scheduledPublish/scheduledTasks.xml
  * Copyright (c) 2026 OJS Services. Distributed under the GNU GPL v3; see LICENSE.
  *
  * Both tasks run at most once a minute. The frequency is written as
  * minute="1-59,0" and not minute="*": the acron plugin treats an attribute
  * that compares equal to 0 as "no frequency" and falls back to once a day, and
  * on PHP 7 the string "*" compares equal to 0.
  -->
<scheduled_tasks>
	<task class="plugins.generic.scheduledPublish.classes.ScheduledPublishIssueTask">
		<descr>Publish issues whose scheduled date and time have arrived.</descr>
		<frequency minute="1-59,0"/>
	</task>
	<task class="plugins.generic.scheduledPublish.classes.ScheduledPublishSubmissionsTask">
		<descr>Publish articles whose scheduled publication date has arrived, in published issues only.</descr>
		<frequency minute="1-59,0"/>
	</task>
</scheduled_tasks>
